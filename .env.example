# ── ACE environment ──────────────────────────────────────────────────────────
# Copy to .env.local and fill in. The web app reads VITE_* vars at build time;
# the serverless LLM proxy (api/llm.js) reads the non-prefixed keys at runtime.

# ── Auth (Supabase) ──────────────────────────────────────────────────────────
# Real sign-in via magic link. Without these, the app stays local-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── LLM proxy keys (server-side, used by api/llm.js) ─────────────────────────
# These never reach the browser. The proxy injects them per provider.
# Only the provider(s) you actually use need a key — the others can stay blank.
# If a key is missing, the proxy falls back to the client's BYO key sent via
# the x-client-key header (entered in the app's Settings page).

# DashScope = Alibaba Cloud Model Studio (Qwen / DeepSeek). ACE's default
# provider — get the key from the Model Studio console → API-KEY (intl region).
DASHSCOPE_API_KEY=

# Optional — only set these if you also use Claude / GPT / Gemini.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional — Google Gemini (via Google's OpenAI-compatibility endpoint).
# Get the key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional — NVIDIA NIM (build.nvidia.com), free-tier OpenAI-compatible models.
# Used ONLY for the opt-in QA critic pass + web-knowledge synthesis (off by
# default). NVIDIA's free tier logs/trains on all inputs+outputs and disclaims
# customer-facing use — leave blank unless you've read Settings' disclosure.
NVIDIA_API_KEY=

# Optional — Brave Search API (https://brave.com/search/api/), free tier.
# Backs the live web-knowledge injector when the local KB has no confident
# match. Required only if you enable that feature in Settings.
BRAVE_SEARCH_API_KEY=
